# Local / default release env (used by `pnpm release`)
NODE_ENV="dev"
APP_SLUG="form-fields-pro"
VITE_APP_SLUG="form-fields-pro"
BACKEND_URL="http://localhost:3000"

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Sent as Authorization: Bearer … on POST /api/cdn-release*
CDN_RELEASE_SECRET=""

# Legacy / unused by versioned CDN scripts (kept for template compatibility)
VITE_LICENSE_VALIDATION_API=""
VITE_API_URL=""
